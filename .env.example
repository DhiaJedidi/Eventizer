# ─── Payload ───────────────────────────────────────────────────────────────
# Required. Long random string used to sign/encrypt. Generate: openssl rand -base64 32
PAYLOAD_SECRET=

# Database (SQLite via libSQL). Dev: a local file. Prod (Vercel): a Turso libSQL URL.
# Dev example:
DATABASE_URI=file:./eventizer.db
# Prod example (Turso): DATABASE_URI=libsql://your-db.turso.io
DATABASE_AUTH_TOKEN=

# ─── Media storage — Vercel Blob (production only) ───────────────────────────
# Read/write token for a *public* Vercel Blob store. Set it to enable cloud media;
# dev (unset) uses local disk. Create the store + token via the Vercel dashboard or
# `vercel blob create-store <name> --access public`.
BLOB_READ_WRITE_TOKEN=

# ─── Email (SendGrid) ────────────────────────────────────────────────────────
# API key from https://app.sendgrid.com/settings/api_keys (needs "Mail Send").
SENDGRID_API_KEY=
# Verified sender (SendGrid Single Sender / authenticated domain).
CONTACT_FROM_EMAIL=Eventizer <contact@eventizer.tn>
# Fallback recipient for contact-form notifications. The preferred recipient is
# set in Payload → Contact → "Email de réception des demandes"; this is used only
# when that field is left empty.
CONTACT_TO_EMAIL=contact@eventizer.tn

# ─── Site / analytics ────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.eventizer.tn
NEXT_PUBLIC_GA_ID=
